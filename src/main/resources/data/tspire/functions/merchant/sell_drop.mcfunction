# v0.6.47 multiply by the stack size.
#   BUG FIXED HERE: the tag is Item.Count (capital C) -- the old code used
#   Item.count, the read failed, #SELLN stayed 0 and the price was multiplied
#   by 0, so drop-to-sell silently paid NOTHING. #SELLN is now defaulted to 1
#   so a failed read can only ever fall back to the single-item price.
scoreboard players set #SELLN tspire_timer 1
execute if score #SELL tspire_timer matches 1.. store result score #SELLN tspire_timer run data get entity @s Item.Count
execute if score #SELL tspire_timer matches 1.. run scoreboard players operation #SELL tspire_timer *= #SELLN tspire_timer

# v0.7.4: pay the nearest LIVING player within 16 blocks, then remove the entity.
#   Two fixes: (1) dead/spectating teammates used to be able to receive the gold;
#   (2) the kill used to be unconditional, so an item dropped with no living player
#   within 16 blocks was DELETED WITHOUT PAYMENT.
execute if score #SELL tspire_timer matches 1.. at @s as @p[distance=..16,scores={tspire_dead=0}] run scoreboard players operation @s tspire_gold += #SELL tspire_timer
execute if score #SELL tspire_timer matches 1.. at @s as @p[distance=..16,scores={tspire_dead=0}] run tellraw @s [{"text":"[商人] ","color":"gold"},{"text":"已收购你丢下的物品，获得 ","color":"green"},{"score":{"name":"#SELL","objective":"tspire_timer"},"color":"gold"},{"text":" 金币","color":"gold"},{"text":"  ｜ 当前 ","color":"gray"},{"score":{"name":"@s","objective":"tspire_gold"},"color":"gold"}]
execute if score #SELL tspire_timer matches 1.. at @s as @p[distance=..16,scores={tspire_dead=0}] run playsound minecraft:entity.item.pickup master @s ~ ~ ~ 0.7 1.4
execute if score #SELL tspire_timer matches 1.. at @s if entity @a[distance=..16,scores={tspire_dead=0}] run kill @s
execute if score #SELL tspire_timer matches 0 if entity @s[nbt={Age:..40}] at @s as @p[distance=..16,scores={tspire_dead=0}] run tellraw @s [{"text":"[商人] ","color":"gold"},{"text":"这件东西我不收。","color":"red"}]
