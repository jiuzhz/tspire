# Give one floor-appropriate special reward to the executing player.
execute if score #FLOOR tspire_timer matches 1 run loot give @s loot tspire:rewards/special_f1
execute if score #FLOOR tspire_timer matches 2 run loot give @s loot tspire:rewards/special_f2
execute if score #FLOOR tspire_timer matches 3 run loot give @s loot tspire:rewards/special_f3
